{
  "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
  "theme": "tribe",
  "active": "cassist",
  "activateOnStartup": true,
  "keepExistingTerminals": false,
  "sessions": {
    "cassist": [
      [
        {
          "name": "frontend",
          "autoExecuteCommands": true,
          "icon": "browser",
          "color": "terminal.ansiBlue",
          "commands": [
            "cd frontend",
            "pnpm dev"
          ]
        },
        {
          "name": "api",
          "autoExecuteCommands": true,
          "icon": "server-process",
          "color": "terminal.ansiGreen",
          "commands": [
            "cd backend",
            "source .venv/bin/activate",
            "uvicorn app.main:app --reload"
          ]
        },
        {
          "name": "worker",
          "autoExecuteCommands": true,
          "icon": "gear",
          "color": "terminal.ansiYellow",
          "commands": [
            "cd backend",
            "source .venv/bin/activate",
            "cassist-worker"
          ]
        }
      ]
    ],
    "default": [
      {
        "name": "hello",
        "autoExecuteCommands": true,
        "icon": "person",
        "color": "terminal.ansiGreen",
        "commands": [
          "echo hello"
        ]
      },
      [
        {
          "name": "docker:ros",
          "commands": [
            ""
          ]
        },
        {
          "name": "docker:k8s",
          "commands": [
            ""
          ]
        }
      ],
      [
        {
          "name": "docker:nats",
          "commands": [
            ""
          ]
        },
        {
          "name": "docker:fleet",
          "commands": [
            ""
          ]
        }
      ]
    ]
  }
}
