APP_ENV=development
APP_NAME=CAssist API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://cassist:cassist@localhost:5432/cassist
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Auth0 Universal Login through the backend OIDC adapter.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URL=http://localhost:5173
AUTH_STATE_SECRET=
AUTH_ALLOWED_EMAILS=["owner@example.test"]
AUTH_SESSION_IDLE_SECONDS=28800
AUTH_SESSION_ABSOLUTE_SECONDS=1209600
AUTH_MAX_ACTIVE_SESSIONS=10

# Development/testing defaults. Production validation forces OpenAI.
MODEL_PROVIDER=gemini
MODEL_ID=gemini-3.5-flash-lite
ALLOW_PROVIDER_OVERRIDE=true
PROMPT_VERSION=generic-document-v2
SCHEMA_VERSION=generic-extraction-v1
PREPROCESSING_VERSION=visual-pages-v4
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2. Keep the bucket private.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cassist-documents
R2_PRESIGNED_URL_TTL_SECONDS=300
R2_STORAGE_QUOTA_BYTES=8000000000
UPLOAD_MAX_BYTES=26214400
WORKER_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2
SESSION_CLEANUP_BATCH_SIZE=100
IDEMPOTENCY_MAX_REQUEST_BYTES=1048576
IDEMPOTENCY_MAX_RESPONSE_BYTES=2097152
# Current standard short-context GPT-5.6 Luna rates. Update when pricing changes.
OPENAI_INPUT_COST_PER_MILLION_USD=0.20
OPENAI_OUTPUT_COST_PER_MILLION_USD=1.20
PROVIDER_RATE_LIMIT_RETRY_SECONDS=60
PROVIDER_RATE_LIMIT_MAX_ATTEMPTS=3
PREPROCESSING_MAX_PAGES=50
PREPROCESSING_RENDER_DPI=144
PREPROCESSING_MAX_PIXELS=40000000
PREPROCESSING_MAX_TOTAL_PIXELS=200000000
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=1
