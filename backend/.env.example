APP_ENV=development
APP_NAME=CAssist API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://cassist:cassist@localhost:5432/cassist
CORS_ORIGINS=["http://localhost:5173"]

# Development/testing defaults. Production validation forces OpenAI.
MODEL_PROVIDER=gemini
MODEL_ID=gemini-3.5-flash
ALLOW_PROVIDER_OVERRIDE=true
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2. Keep the bucket private.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cassist-documents
R2_PRESIGNED_URL_TTL_SECONDS=300
