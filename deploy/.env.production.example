POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_URL=postgresql+asyncpg://cassist:replace-with-the-same-url-safe-password@postgres:5432/cassist
CASSIST_POSTGRES_DATA_PATH=/replace/with/nvme/path/cassist/postgres
CASSIST_IMAGE_TAG=latest

APP_ENV=production
FRONTEND_URL=https://cassist.pages.dev
CORS_ORIGINS=["https://cassist.pages.dev"]
EDGE_PROXY_SECRET=replace-with-at-least-32-random-characters

AUTH_ISSUER_URL=https://replace-with-auth0-tenant/
AUTH_CLIENT_ID=replace-with-auth0-client-id
AUTH_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH_STATE_SECRET=replace-with-at-least-32-random-characters
AUTH_CALLBACK_URL=https://cassist.pages.dev/api/v1/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URL=https://cassist.pages.dev

OPENAI_API_KEY=replace-after-production-key-is-available

R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=cassist-documents
