#!/bin/sh
set -eu

require_environment() {
  variable_name="$1"
  eval "variable_value=\${${variable_name}:-}"
  if [ -z "$variable_value" ]; then
    echo "Required restore configuration is missing: $variable_name" >&2
    exit 2
  fi
}

for variable_name in \
  PGHOST \
  PGDATABASE \
  PGUSER \
  PGPASSWORD \
  RESTIC_REPOSITORY \
  RESTIC_PASSWORD
do
  require_environment "$variable_name"
done

export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-/tmp/restic-cache}"
snapshot_id="${1:-latest}"
archive_path="$(mktemp /tmp/cassist-restore.dump.XXXXXX)"
trap 'rm -f "$archive_path"' EXIT HUP INT TERM

restic dump "$snapshot_id" cassist.dump >"$archive_path"
pg_restore \
  --exit-on-error \
  --clean \
  --if-exists \
  --no-owner \
  --no-privileges \
  --dbname="$PGDATABASE" \
  "$archive_path"
