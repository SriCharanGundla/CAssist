{
  "name": "cassist-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:edge",
    "test:unit": "vitest run",
    "test:edge": "WRANGLER_LOG_PATH=.wrangler/edge-test.log vitest run 'functions/api/[[path]].test.js' --config vitest.config.edge.js",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.edge.json",
    "types:workers": "WRANGLER_LOG_PATH=.wrangler/types.log wrangler types worker-configuration.d.ts",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
