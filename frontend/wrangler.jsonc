{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cassist",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
