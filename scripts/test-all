#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$project_root"
docker compose up -d postgres
until docker compose exec -T postgres pg_isready -U cassist -d cassist >/dev/null 2>&1; do
  sleep 1
done

cd "$project_root/backend"
uv sync --locked --dev
uv run alembic upgrade head
uv run ruff check .
uv run mypy app
uv run pytest -q --cov --cov-report=term-missing

cd "$project_root/frontend"
pnpm install --frozen-lockfile
pnpm test
pnpm test:coverage
pnpm typecheck
pnpm lint
pnpm build
